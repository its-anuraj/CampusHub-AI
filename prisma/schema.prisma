datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   // ADMIN, FACULTY, STUDENT, PARENT
  avatar    String?
  phone     String?
  city      String?
  state     String?
  pincode   String?
  address   String?
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE, PENDING
  verificationStatus String @default("VERIFIED") // VERIFIED, PENDING_APPROVAL, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile Student?
  facultyProfile Faculty?
  parentProfile  Parent?
  adminProfile   AdminProfile?
  notices        Notice[]
  logs           AuditLog[]
}

model AdminProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId     String   @unique
  departmentRole String   // PLACEMENT_CELL, FEES_ACCOUNTS, LIBRARY, EVENT_MANAGER, CLUB_MANAGER, ACADEMIC_ADMIN, HOSTEL_ADMIN, DIRECTOR
  designation    String   @default("Department Administrator")
}

model Student {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNumber         String   @unique
  admissionNumber    String?  @unique
  department         String
  year               Int      @default(3)
  semester           Int      @default(5)
  section            String   @default("A")
  cgpa               Float    @default(8.2)
  backlogs           Int      @default(0)
  academicStatus     String   @default("REGULAR") // REGULAR, YEAR_BACK, DETAINED, PROMOTED
  verificationStatus String   @default("VERIFIED") // VERIFIED, PENDING_APPROVAL, REJECTED
  classAdvisor       String?  @default("Dr. Priya Sharma")
  guardianName       String?
  guardianRelation   String?
  guardianPhone      String?
  city               String?
  state              String?
  pincode            String?
  address            String?
  parentId           String?
  parent             Parent?  @relation(fields: [parentId], references: [id])

  submissions        Submission[]
  attendance         Attendance[]
  applications       PlacementApplication[]
  fees               FeeRecord[]
  complaints         Complaint[]
  courses            CourseEnrollment[]
  academicHistories  AcademicHistory[]
}

model Faculty {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId  String   @unique
  department  String
  designation String   @default("Assistant Professor")
  subjects    String   // JSON string array
}

model Parent {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  relation          String    @default("Father")
  studentRollNumber String?
  studentName       String?
  targetDepartment  String?
  targetYear        Int?
  targetSemester    Int?
  targetSection     String?
  students          Student[]
}

model Notice {
  id          String   @id @default(uuid())
  title       String
  content     String
  category    String   // GENERAL, EXAM, EVENT, PLACEMENT, URGENT
  priority    String   // LOW, MEDIUM, HIGH, URGENT
  department  String   @default("ALL")
  isPinned    Boolean  @default(false)
  createdBy   String
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
}

model Assignment {
  id          String       @id @default(uuid())
  title       String
  subject     String
  description String
  dueDate     DateTime
  totalMarks  Int          @default(20)
  facultyName String
  submissions Submission[]
  createdAt   DateTime     @default(now())
}

model Submission {
  id            String     @id @default(uuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status        String     @default("SUBMITTED") // PENDING, SUBMITTED, GRADED, LATE
  marksObtained Int?
  feedback      String?
  submittedAt   DateTime   @default(now())
}

model Attendance {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   String
  date      DateTime @default(now())
  status    String   // PRESENT, ABSENT, LATE
  markedBy  String
}

model PlacementCompany {
  id           String                 @id @default(uuid())
  name         String
  role         String
  package      String
  minCgpa      Float                  @default(6.0)
  departments  String                 // JSON string array
  deadline     DateTime
  status       String                 @default("OPEN") // OPEN, UPCOMING, CLOSED
  applicants   Int                    @default(0)
  applications PlacementApplication[]
}

model PlacementApplication {
  id        String           @id @default(uuid())
  companyId String
  company   PlacementCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    String           @default("APPLIED")
  appliedAt DateTime         @default(now())
}

model FeeRecord {
  id        String    @id @default(uuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      String
  amount    Float
  dueDate   DateTime
  paidDate  DateTime?
  status    String    @default("PENDING") // PAID, PENDING, OVERDUE
  receipt   String?
}

model LibraryBook {
  id              String   @id @default(uuid())
  title           String
  author          String
  isbn            String   @unique
  subject         String
  totalCopies     Int      @default(5)
  availableCopies Int      @default(3)
  available       Boolean  @default(true)
}

model DiscussionPost {
  id          String   @id @default(uuid())
  title       String
  content     String
  author      String
  isAnonymous Boolean  @default(false)
  tags        String   // CSV string
  likes       Int      @default(0)
  replies     Int      @default(0)
  createdAt   DateTime @default(now())
}

model Complaint {
  id          String    @id @default(uuid())
  studentId   String?
  student     Student?  @relation(fields: [studentId], references: [id])
  title       String
  description String
  category    String    // HOSTEL, ELECTRICITY, INTERNET, WATER, CLEANING, OTHER
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED, CLOSED
  submittedBy String
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  type      String   @default("INFO") // INFO, WARNING, ERROR, SUCCESS
  timestamp DateTime @default(now())
}

model Course {
  id          String             @id @default(uuid())
  code        String             @unique // e.g. CS501
  title       String
  department  String             // e.g. CSE, IT, ECE
  credits     Int                @default(4)
  semester    Int                @default(5)
  description String
  syllabus    String             // JSON string array of topics
  facultyName String?            @default("Dr. Sharma")
  enrollments CourseEnrollment[]
  createdAt   DateTime           @default(now())
}

model CourseEnrollment {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    String   @default("ENROLLED") // ENROLLED, COMPLETED, DROPPED
  grade     String?  @default("A")
  createdAt DateTime @default(now())
}

model HostelRoom {
  id          String             @id @default(uuid())
  block       String             // Block A, Block B, Block C (Girls), Block D (PG)
  roomNumber  String             // e.g. 101, 204, 305
  capacity    Int                @default(2)
  occupied    Int                @default(0)
  roomType    String             @default("DOUBLE_AC") // SINGLE_AC, DOUBLE_AC, TRIPLE_NON_AC
  floor       Int                @default(1)
  monthlyRent Float              @default(6500)
  status      String             @default("AVAILABLE") // AVAILABLE, OCCUPIED, MAINTENANCE
  allocations HostelAllocation[]
}

model HostelAllocation {
  id         String     @id @default(uuid())
  roomId     String
  room       HostelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  studentId  String
  allocatedAt DateTime  @default(now())
  status     String     @default("ACTIVE") // ACTIVE, VACATED
}

model HostelMaintenance {
  id          String   @id @default(uuid())
  studentName String
  roomNumber  String
  block       String
  category    String   // PLUMBING, ELECTRICAL, FURNITURE, INTERNET, CLEANING
  issue       String
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  createdAt   DateTime @default(now())
}

model CampusEvent {
  id            String              @id @default(uuid())
  title         String
  description   String
  category      String              // HACKATHON, WORKSHOP, CULTURAL, SPORTS, SEMINAR
  venue         String
  date          DateTime
  time          String
  organizer     String
  bannerUrl     String?
  maxCapacity   Int                 @default(100)
  registered    Int                 @default(0)
  status        String              @default("UPCOMING") // UPCOMING, ONGOING, COMPLETED
  registrations EventRegistration[]
  createdAt     DateTime            @default(now())
}

model EventRegistration {
  id            String      @id @default(uuid())
  eventId       String
  event         CampusEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentName   String
  rollNumber    String
  email         String
  ticketCode    String      @unique
  checkedIn     Boolean     @default(false)
  registeredAt  DateTime    @default(now())
}

model DigitalCertificate {
  id             String   @id @default(uuid())
  certificateId  String   @unique // e.g. CHUB-CERT-2026-9812
  studentName    String
  rollNumber     String
  courseOrTitle  String
  type           String   // BONAFIDE, COURSE_COMPLETION, MERIT, INTERNSHIP_NOC
  issueDate      DateTime @default(now())
  issuedBy       String   @default("Office of Academic Affairs")
  digitalHash    String   // SHA-256 integrity hash
  status         String   @default("VERIFIED") // VERIFIED, REVOKED
}

model FacultyLeave {
  id          String    @id @default(uuid())
  facultyName String
  employeeId  String
  department  String
  leaveType   String    // CASUAL, MEDICAL, DUTY_LEAVE, MATERNITY_PATERNITY
  startDate   DateTime
  endDate     DateTime
  daysCount   Int
  reason      String
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
  substitute  String?
  reviewedBy  String?
  appliedAt   DateTime  @default(now())
}

model AlumniProfile {
  id          String   @id @default(uuid())
  name        String
  batch       String   // e.g. Class of 2022
  department  String
  company     String
  designation String
  linkedinUrl String?
  location    String
  avatar      String?
  bio         String
  isMentor    Boolean  @default(true)
}

model LostFoundItem {
  id          String   @id @default(uuid())
  title       String
  type        String   // LOST, FOUND
  category    String   // ELECTRONICS, ID_CARDS, BAGS, KEYS, BOOKS, OTHER
  location    String
  date        DateTime @default(now())
  description String
  reportedBy  String
  contactInfo String
  status      String   @default("OPEN") // OPEN, CLAIMED, HANDED_OVER
  imageUrl    String?
}

model Scholarship {
  id           String                   @id @default(uuid())
  title        String
  provider     String                   // Institute, Government, Alumni Fund, Corporate
  amount       Float
  deadline     DateTime
  minCgpa      Float                    @default(7.5)
  familyIncome Float                    @default(500000)
  description  String
  category     String                   // MERIT, NEED_BASED, MINORITY, SPORTS
  status       String                   @default("ACTIVE")
  applications ScholarshipApplication[]
}

model ScholarshipApplication {
  id            String      @id @default(uuid())
  scholarshipId String
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  studentName   String
  rollNumber    String
  cgpa          Float
  annualIncome  Float
  status        String      @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED
  appliedAt     DateTime    @default(now())
}

model CafeteriaItem {
  id          String   @id @default(uuid())
  name        String
  stall       String   // Food Court A, South Stall, Nescafe Cafe, Juice Bar
  category    String   // BREAKFAST, LUNCH, SNACKS, BEVERAGES
  price       Float
  calories    Int      @default(250)
  isVeg       Boolean  @default(true)
  isAvailable Boolean  @default(true)
  imageUrl    String?
}

model WellnessAppointment {
  id          String   @id @default(uuid())
  studentName String
  rollNumber  String
  counselor   String   @default("Dr. Maya Sen (Senior Psychologist)")
  type        String   // MENTAL_HEALTH, CLINICAL_DOCTOR, ACADEMIC_STRESS
  slotTime    String
  date        DateTime
  isAnonymous Boolean  @default(false)
  status      String   @default("CONFIRMED") // CONFIRMED, COMPLETED, CANCELLED
}

model ResearchPaper {
  id          String   @id @default(uuid())
  title       String
  facultyName String
  department  String
  journal     String   // IEEE Transactions, Springer Nature, Elsevier
  doi         String?
  year        Int      @default(2026)
  citations   Int      @default(0)
  abstract    String
  downloadUrl String?
  createdAt   DateTime @default(now())
}

model LabEquipment {
  id          String   @id @default(uuid())
  name        String   // NVIDIA DGX GPU Cluster, 3D Resin Printer, IoT Sensor Rig
  labName     String   // Advanced AI Lab, Robotics Lab, VLSI Fab
  department  String
  totalUnits  Int      @default(1)
  status      String   @default("OPERATIONAL") // OPERATIONAL, UNDER_MAINTENANCE
  hourlyRate  Float    @default(0)
}

model CampusAsset {
  id           String   @id @default(uuid())
  assetTag     String   @unique // ASSET-2026-IT-004
  name         String
  category     String   // COMPUTING, AV_EQUIPMENT, LAB_HARDWARE, FURNITURE
  location     String   // Room 402, Admin Block, Audi-1
  purchaseDate DateTime
  warrantyEnd  DateTime
  cost         Float
  status       String   @default("ACTIVE") // ACTIVE, MAINTENANCE, RETIRED
}

model EmergencyAlert {
  id          String   @id @default(uuid())
  title       String
  message     String
  severity    String   // CRITICAL, HIGH, WARNING, INFO
  channels    String   // SMS, EMAIL, PUSH, SIREN (CSV)
  active      Boolean  @default(true)
  sentBy      String
  createdAt   DateTime @default(now())
}

model StudentClub {
  id          String   @id @default(uuid())
  name        String   // Robotics Club, ACM Student Chapter, Google Developer Group
  category    String   // TECHNICAL, CULTURAL, SPORTS, LITERARY
  president   String
  facultyLead String
  members     Int      @default(0)
  description String
  bannerUrl   String?
}

model ParentFeedback {
  id          String   @id @default(uuid())
  parentName  String
  studentRoll String
  category    String   // ACADEMICS, HOSTEL, TRANSPORT, SAFETY, FEES
  subject     String
  message     String
  status      String   @default("PENDING") // PENDING, INVESTIGATING, RESOLVED
  response    String?
  createdAt   DateTime @default(now())
}

// --- Pre-Approved Admission Master Roster ---
model AdmissionMaster {
  id              String   @id @default(uuid())
  admissionNumber String   @unique // Official College Roll / Admission No (e.g. CS2026-001)
  studentName     String
  department      String   // CSE, IT, ECE, MECH, CIVIL
  admissionYear   Int      @default(2026)
  initialYear     Int      @default(1)
  initialSemester Int      @default(1)
  initialSection  String   @default("A")
  guardianPhone   String?
  guardianName    String?
  isClaimed       Boolean  @default(false)
  claimedUserId   String?  @unique
  createdAt       DateTime @default(now())
}

// --- Dynamic Academic Sessions & Sections ---
model AcademicSession {
  id          String         @id @default(uuid())
  sessionName String         // e.g. "2026-2027 ODD SEMESTER"
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean        @default(true)
  sections    ClassSection[]
}

model ClassSection {
  id              String                 @id @default(uuid())
  sessionId       String
  session         AcademicSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  department      String                 // CSE
  year            Int                    // 1, 2, 3, 4
  semester        Int                    // 1, 2, 3, 4, 5, 6, 7, 8
  sectionName     String                 // "A", "B", "C"
  classAdvisorId  String?                // Faculty Mentor
  capacity        Int                    @default(60)
  courseMappings  SectionCourseFaculty[]
}

model SectionCourseFaculty {
  id             String       @id @default(uuid())
  classSectionId String
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  courseCode     String       // e.g. CS501
  courseName     String       // Data Structures & Algorithms
  facultyId      String       // Assigned Faculty User ID
  facultyName    String
}

// --- Historical Transcript & Promotion Audit Trail ---
model AcademicHistory {
  id              String   @id @default(uuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear    String   // e.g. "2025-2026"
  semester        Int      // 1
  year            Int      // 1
  section         String   // "A"
  sgpa            Float    @default(8.0)
  backlogsCount   Int      @default(0)
  attendancePct   Float    @default(85.0)
  promotionStatus String   // PROMOTED, YEAR_BACK, DETAINED, COMPLETED
  createdAt       DateTime @default(now())
}


